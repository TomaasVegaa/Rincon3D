# =============================================================================
# .HTACCESS - CONFIGURACIÓN DE RENDIMIENTO Y SEO (HOSTINGER & APACHE)
# =============================================================================

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Sitemap Dinámico XML
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 2. URLs amigables de Productos (SEO)
  # Ejemplo: tudominio.com/producto/lampara-litofania-lunar-personalizada
  RewriteRule ^producto/([a-zA-Z0-9_-]+)/?$ producto.php?slug=$1 [L,QSA]

  # 3. Categorías amigables (SEO)
  # Ejemplo: tudominio.com/categoria/iluminacion
  RewriteRule ^categoria/([a-zA-Z0-9_-]+)/?$ index.php?categoria=$1 [L,QSA]
</IfModule>

# =============================================================================
# SEGURIDAD: Proteger archivos sensibles
# =============================================================================
<FilesMatch "\.(sql|json|md|log|sh|env)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Permitir específicamente el manifest si existiera
<Files "robots.txt">
  Allow from all
</Files>

# =============================================================================
# COMPRESIÓN GZIP (Acelera la carga y mejora el puntaje de Google Core Web Vitals)
# =============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =============================================================================
# DESACTIVAR CACHÉ EN LITESPEED Y PROXIES (ACTUALIZACIONES EN VIVO AL INSTANTE)
# =============================================================================
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_headers.c>
  # Cabeceras globales de no-caché para que los cambios del admin se vean de inmediato
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
  Header always set X-LiteSpeed-Cache-Control "no-cache"
</IfModule>

# Permitir caché únicamente para recursos multimedia estáticos (imágenes y fuentes)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000"
  </IfModule>
</FilesMatch>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
